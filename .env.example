# Copy to .env (git-ignored). Values are read by data_navigator.config.Secrets.
# Never put these in config.yaml.

# Password of the dedicated catalog-building Starburst user (starburst.builder.user).
DN_BUILDER_PASSWORD=

# Credentials of the person running the agent (used only for EXPLAIN and samples).
DN_END_USER_USER=
DN_END_USER_PASSWORD=
# Alternative to the password when starburst.connection.auth is "jwt".
DN_END_USER_JWT=

# GitLab personal/project access token with read_repository scope.
DN_GITLAB_TOKEN=

# Internal LLMaaS API key.
DN_LLM_API_KEY=
